# ============================================================
#  CLES API DU MONTEUR — le SEUL fichier a configurer.
#  Remplir les valeurs apres le "=" (pas de guillemets, pas d'espaces).
# ============================================================

# --- IA n°1 : Google Gemini (OBLIGATOIRE pour le verdict principal) ---
# Cle gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cles de secours optionnelles (autres comptes) : bascule auto si quota epuise
GEMINI_API_KEY_2=

# --- IA n°2 : Qwen-Omni / Alibaba Model Studio (secours video+audio si Gemini a quota) ---
# Cle gratuite ~90 jours : https://modelstudio.console.alibabacloud.com (region Singapour)
DASHSCOPE_API_KEY=

# --- Optionnel : Pexels pour les images/b-roll de representation ---
# Cle gratuite : https://www.pexels.com/api/
PEXELS_API_KEY=
